-- ==========================================
-- 1. เคลียร์ตารางและฟังก์ชันเดิม (เริ่มต้นใหม่)
-- ==========================================
drop function if exists reserve_book(uuid, uuid);
drop table if exists public.reservations cascade;
drop table if exists public.books cascade;

-- ==========================================
-- 2. สร้างตารางหนังสือ (books)
-- ==========================================
create table public.books (
  id uuid default gen_random_uuid() primary key,
  title text not null,
  author text not null,
  category text default 'ทั่วไป',
  cover_url text,
  total_copies int default 1 check (total_copies >= 0),
  available_copies int default 1 check (available_copies >= 0),
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- ==========================================
-- 3. สร้างตารางการจอง (reservations)
-- ==========================================
create table public.reservations (
  id uuid default gen_random_uuid() primary key,
  user_id uuid references auth.users(id) on delete cascade not null,
  book_id uuid references public.books(id) on delete cascade not null,
  status text check (status in ('reserved', 'borrowed', 'returned', 'cancelled')) default 'reserved',
  reserved_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- ==========================================
-- 4. เปิดใช้งาน Row Level Security (RLS)
-- ==========================================
alter table public.books enable row level security;
alter table public.reservations enable row level security;

-- ==========================================
-- 5. กำหนดสิทธิ์การเข้าถึงข้อมูล (RLS Policies)
-- ==========================================
-- สิทธิ์สำหรับตาราง books
create policy "Allow public read books" on public.books for select using (true);
create policy "Allow update books stock" on public.books for update using (true);

-- สิทธิ์สำหรับตาราง reservations
create policy "Allow user select own reservations" on public.reservations for select using (auth.uid() = user_id);
create policy "Allow user insert own reservations" on public.reservations for insert with check (auth.uid() = user_id);

-- ==========================================
-- 6. สร้าง Stored Procedure (RPC) สำหรับตัดสต็อกการจอง
-- ==========================================
create or replace function reserve_book(p_book_id uuid, p_user_id uuid)
returns json as $$
declare
    v_available int;
begin
    -- ล็อกแถวหนังสือเพื่อตรวจสอบจำนวนคงเหลือแบบเรียลไทม์
    select available_copies into v_available
    from public.books
    where id = p_book_id
    for update;

    if v_available is null then
        return json_build_object('success', false, 'message', 'ไม่พบหนังสือในระบบ');
    end if;

    if v_available <= 0 then
        return json_build_object('success', false, 'message', 'หนังสือเล่มนี้ถูกจองเต็มแล้ว');
    end if;

    -- ลดจำนวนหนังสือคงเหลือลง 1
    update public.books
    set available_copies = available_copies - 1
    where id = p_book_id;

    -- เพิ่มบันทึกการจอง
    insert into public.reservations (user_id, book_id, status)
    values (p_user_id, p_book_id, 'reserved');

    return json_build_object('success', true, 'message', 'จองหนังสือเรียบร้อยแล้ว!');
end;
$$ language plpgsql security definer;

